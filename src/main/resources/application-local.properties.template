# ----------------------------------------------------------------------
#  application-local.properties.template
#  Copy to application-local.properties (which IS git-ignored) and fill in
#  the real local-development values. Never commit the populated file.
#
#  Production / stage / uat / dev secrets are NOT defined here — those are
#  injected via environment variables sourced from AWS Secrets Manager.
# ----------------------------------------------------------------------
spring.application.name=vimaadmin
server.port=8080
server.servlet.context-path=/local

# Local Postgres (docker-compose)
spring.datasource.url=jdbc:postgresql://localhost:5432/vima_local
spring.datasource.username=vima_user
spring.datasource.password=CHANGE_ME_LOCAL_DEV_ONLY
spring.datasource.driver-class-name=org.postgresql.Driver

# JWT signing key for local dev only (HS256, base64-encoded 32 bytes)
jwt.securitykey=REDACTED
jwt.expiration=900000
jwt.refreshexpiration=604800000

# CORS for the local SPA
cors.allowed-origins=http://localhost:5173,http://localhost:8080
cors.allowed-methods=GET,POST,PUT,PATCH,DELETE,OPTIONS
cors.allowed-headers=Authorization,Content-Type,X-Requested-With,X-Correlation-Id,X-CSRF-Token,Accept,Origin,X-Organization-ID
cors.allow-credentials=true

# F-22: RedirectTargetValidator — Keycloak execute-actions emails (e.g. password reset) and any server-built redirect URIs.
# Must include app.base-url origin; paths such as /login are allowed when the origin matches.
redirect.url=http://localhost:8080
redirect.allowed-targets=http://localhost:8080,http://localhost:5173,http://localhost:8081

# Application Base URL for email links (enrollment magic links, password-reset redirect, etc.)
app.base-url=http://localhost:8080

# Enrollment magic-link HMAC (F-09). Set VIMA_ENROLLMENT_TOKEN_SECRET in env or replace default below.
app.enrollment-token-secret=${VIMA_ENROLLMENT_TOKEN_SECRET:CHANGE_ME_LOCAL_DEV_ONLY}

# Keycloak (sole IdP — dev/prod no longer use Authentik)
keycloak.auth-server-url=http://localhost:8081
keycloak.realm=vima-local
keycloak.client-id=vima-backend
keycloak.client-secret=
keycloak.service.client-id=vima-service
keycloak.service.client-secret=

# Mail — use Mailpit/Mailhog locally; prod uses SES
spring.mail.host=localhost
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
mail.provider=ses
aws.ses.region=ap-south-1
aws.ses.access-key=
aws.ses.secret-key=
aws.ses.from-email=no-reply@vimainsurance.local

# Claim admin email: skip legacy "manual submission to insurer" template only (matches dev/stage/prod). Set true to re-enable.
claims.email.manual-submission-admin-notification-enabled=false

# S3 (use LocalStack or a sandbox bucket)
aws.s3.access-key=
aws.s3.secret-key=
aws.s3.region=ap-south-1
aws.s3.bucket-name=vimainsurance-local
aws.s3.endpoint=
aws.s3.presigned-url-expiration=300
aws.s3.server-side-encryption.kms-key-id=
